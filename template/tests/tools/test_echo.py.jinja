"""Tests for the echo tool."""

from fastmcp import FastMCP

from {{ package_name }}.tools.echo import register


async def test_echo_returns_success_envelope():
    mcp = FastMCP("test")
    register(mcp)

    tool = await mcp.get_tool("echo")
    assert tool is not None

    # fastmcp 3.x public API: ``await mcp.call_tool(name, args)`` returns a
    # ``ToolResult`` whose ``.structured_content`` holds the dict the tool
    # function returned.
    result = await mcp.call_tool("echo", {"message": "hello"})
    assert result.structured_content == {
        "status": "success",
        "data": {"echoed": "hello"},
    }
