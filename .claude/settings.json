{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "effortLevel": "high",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "uv add *",
      "uv remove *",
      "uv lock *",
      "uv sync *",
      "uv version *",
      "make format",
      "make format-project-text",
      "make format-toml",
      "make bump-patch",
      "make bump-minor",
      "make bump-major",
      "git switch *",
      "git checkout *",
      "git pull *",
      "git merge *",
      "git rebase *",
      "git restore *",
      "git stash *",
      "git reset *",
      "git cherry-pick *",
      "git push *",
      "git branch *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.cache/pre-commit",
        "~/.cache/pyright-python"
      ],
      "denyWrite": [
        "./pyproject.toml",
        "./uv.lock"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "pyright-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      },
      "autoUpdate": true
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": true
    }
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(make install)",
      "Bash(make setup)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make test-integration)",
      "Bash(make test-permissions)",
      "Bash(make lint)",
      "Bash(make lint-fix)",
      "Bash(make format)",
      "Bash(make format-check)",
      "Bash(make format-md)",
      "Bash(make format-md-check)",
      "Bash(make format-toml)",
      "Bash(make format-toml-check)",
      "Bash(make format-yaml)",
      "Bash(make format-yaml-check)",
      "Bash(make format-json)",
      "Bash(make format-json-check)",
      "Bash(make format-ruff)",
      "Bash(make format-ruff-check)",
      "Bash(make typecheck)",
      "Bash(make docs-build)",
      "Bash(make lock-check)",
      "Bash(make test-one TEST=tests/*)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock *)",
      "Bash(uv sync *)",
      "Bash(uv version *)"
    ],
    "ask": [
      "Edit(/pyproject.toml)",
      "Edit(/uv.lock)",
      "Edit(/scripts/hooks/guard_config.py)",
      "Bash(git checkout *pyproject.toml*)",
      "Bash(git checkout *uv.lock*)",
      "Bash(git restore *pyproject.toml*)",
      "Bash(git restore *uv.lock*)",
      "Bash(uv *--script*)"
    ]
  }
}
